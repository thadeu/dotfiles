    "workbench.externalBrowser": "/Applications/Brave Browser.app",
    "terminal.integrated.shellIntegration.enabled": true,
    "terminal.integrated.tabs.enabled": false,
    "terminal.integrated.mouseWheelScrollSensitivity": 3,
    "go.toolsManagement.autoUpdate": true,
    "window.confirmSaveUntitledWorkspace": false,
    "clowk.folders.associations": {
        "default": { "color": "yellow", "glyph": "book" },
        "kamailio": { "color": "teal", "glyph": "code" },
        "rtpengine": { "color": "red" },
    },
    "workbench.colorTheme": "Clowk Night",
    "workbench.iconTheme": "clowk",
    "chat.mcp.discovery.enabled": {
        "claude-desktop": true,
        "cursor-global": true,
        "cursor-workspace": true
    },
    "chat.mcp.gallery.enabled": true,
    "security.promptForLocalFileProtocolHandling": false,
    "markdown-mermaid.controls.show": "never",
    "markdown-mermaid.mouseNavigation.enabled": "never"
}